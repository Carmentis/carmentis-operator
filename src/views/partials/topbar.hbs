<div class="topbar">
	<div class="topbar-logo">
		<img src="/admin/static/assets/carmentis.svg" alt="Carmentis" class="topbar-logo-img">
	</div>
	<div class="topbar-spacer"></div>
	{{#if user}}
	<div class="user-section">
		<a href="/admin/account" id="my-account" class="user-link {{#if (eq currentSection "account")}}active{{/if}}" title="My account">
			<div class="user-avatar">{{user.pseudo.[0]}}</div>
			<span class="user-pseudo">{{user.pseudo}}</span>
		</a>
		<form method="POST" action="/admin/logout" style="display: inline;">
			<button type="submit" class="btn-logout" title="Logout">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="#16A34A">
					<path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
				</svg>
			</button>
		</form>
	</div>
	{{/if}}
</div>
