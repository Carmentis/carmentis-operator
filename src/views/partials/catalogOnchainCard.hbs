<section class="catalog-card catalog-card-onchain" id="onchain-card">
	<div class="catalog-card-header">
		<h3>{{title}}</h3>
		<span class="badge" id="onchain-count">…</span>
	</div>
	<p class="catalog-subtitle">{{subtitle}}</p>
	<p class="catalog-empty" id="onchain-loading">Looking up on-chain {{noun}}…</p>
	<div id="onchain-wallets"></div>
	<p class="catalog-empty" id="onchain-empty" hidden>Nothing to import: everything found on-chain is already registered.</p>
</section>
