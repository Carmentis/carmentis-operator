<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{#if apiKey}}Edit{{else}}New{{/if}} API Key - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>{{#if apiKey}}Edit API key{{else}}New API key{{/if}}</h2>

				{{>flash}}

				<form method="post" action="{{#if apiKey}}/admin/api-keys/{{apiKey.id}}/update{{else}}/admin/api-keys{{/if}}">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required value="{{apiKey.name}}">
					</div>
					<div class="form-group">
						<label for="applicationVbId">Application (optional)</label>
						<select id="applicationVbId" name="applicationVbId">
							<option value="">— none —</option>
							{{#each applications}}
							<option value="{{this.vbId}}" {{#if (eq this.vbId ../apiKey.application.vbId)}}selected{{/if}}>{{this.name}}</option>
							{{/each}}
						</select>
					</div>
					<div class="form-group">
						<label for="walletId">Wallet (optional)</label>
						<select id="walletId" name="walletId">
							<option value="">— none —</option>
							{{#each wallets}}
							<option value="{{this.id}}" {{#if (eq this.id ../apiKey.wallet.id)}}selected{{/if}}>{{this.name}}</option>
							{{/each}}
						</select>
					</div>
					<div class="form-group">
						<label for="endpointRegex">Endpoint regex (optional)</label>
						<input type="text" id="endpointRegex" name="endpointRegex" value="{{apiKey.endpointRegex}}">
					</div>
					<div class="form-group">
						<label for="activeUntil">Active until (optional)</label>
						<input type="date" id="activeUntil" name="activeUntil" data-initial-value="{{apiKey.activeUntil}}">
					</div>
					<div class="form-group">
						<label for="gasMinAtomics">Minimum gas price (atomics)</label>
						<input type="number" id="gasMinAtomics" name="gasMinAtomics" min="0" value="{{#if apiKey}}{{apiKey.gasMinAtomics}}{{else}}0{{/if}}">
					</div>
					<div class="form-group">
						<label for="gasMaxAtomics">Maximum gas price (atomics)</label>
						<input type="number" id="gasMaxAtomics" name="gasMaxAtomics" min="0" value="{{#if apiKey}}{{apiKey.gasMaxAtomics}}{{else}}1000000{{/if}}">
					</div>

					<button type="submit" class="btn btn-primary">{{#if apiKey}}Save changes{{else}}Create API key{{/if}}</button>
					<a href="/admin/api-keys" class="btn btn-secondary">Cancel</a>
				</form>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
	<script>
		// <input type="date"> needs YYYY-MM-DD, the stored value is a full timestamp.
		const activeUntilInput = document.getElementById('activeUntil');
		const initialActiveUntil = activeUntilInput.getAttribute('data-initial-value');
		if (initialActiveUntil) {
			activeUntilInput.value = new Date(initialActiveUntil).toISOString().slice(0, 10);
		}
	</script>
</body>
</html>
