<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Users - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Users</h2>
				<p class="text">
					Below are listed users able to access this operator.
					Users can be added through the invitation process.
				</p>
				<p class="text">
					<a href="/admin/invitations" class="btn btn-primary">Invite new user</a>
				</p>



				{{>flash}}
				<div class="flash flash-error" id="users-error" style="display:none;"></div>
				<div class="flash flash-success" id="users-success" style="display:none;"></div>
				<table>
					<thead>
					<tr>
						<th>Pseudo</th>
						<th>Public key</th>
						<th>Created</th>
						<th>Actions</th>
					</tr>
					</thead>
					<tbody>
					{{#each users}}
					<tr>
						<td>{{this.pseudo}}</td>
						<td><code style="word-break: break-all;">{{this.publicKey}}</code></td>
						<td>{{this.createdAt}}</td>
						<td>
							<button type="button" class="btn btn-sm btn-danger delete-user-btn" data-user-id="{{this.id}}" data-user-pseudo="{{this.pseudo}}" {{#if (eq this.id user.id)}}disabled title="You cannot delete your own account"{{/if}}>Delete</button>
						</td>
					</tr>
					{{else}}
					<tr><td colspan="4">No users yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
	<script>
		document.querySelectorAll('.delete-user-btn').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const userId = btn.getAttribute('data-user-id');
				const userPseudo = btn.getAttribute('data-user-pseudo');
				const errorEl = document.getElementById('users-error');
				const successEl = document.getElementById('users-success');

				const confirmed = confirm(`Are you sure you want to delete user "${userPseudo}"? This action cannot be undone.`);
				if (!confirmed) return;

				errorEl.style.display = 'none';
				successEl.style.display = 'none';

				try {
					const res = await fetch(`/admin/api/v1/user/${userId}`, { method: 'DELETE' });
					if (!res.ok) {
						const data = await res.json().catch(() => ({}));
						throw new Error(data.message || 'Could not delete user.');
					}
					successEl.textContent = `User "${userPseudo}" deleted successfully. Reloading...`;
					successEl.style.display = '';
					setTimeout(() => {
						window.location.reload();
					}, 1500);
				} catch (err) {
					errorEl.textContent = err.message || 'Could not delete user.';
					errorEl.style.display = '';
				}
			});
		});
	</script>
</body>
</html>
