<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Users - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Users</h2>
				<p class="text">
					Below are listed users able to access this operator.
					To add a user, first generate an invitation link and send this invitation link
					to the desired user.
				</p>


				{{>flash}}
				<table>
					<thead>
					<tr>
						<th>Pseudo</th>
						<th>Public key</th>
						<th>Created</th>
					</tr>
					</thead>
					<tbody>
					{{#each users}}
					<tr>
						<td>{{this.pseudo}}</td>
						<td><code style="word-break: break-all;">{{this.publicKey}}</code></td>
						<td>{{this.createdAt}}</td>
					</tr>
					{{else}}
					<tr><td colspan="3">No users yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
