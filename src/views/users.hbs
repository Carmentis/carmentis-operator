<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Users - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Users</h2>
				<p class="text">
					Below are listed users able to access this operator.
					Users can be added through the invitation process.
				</p>
				<p class="text">
					<a href="/admin/invitations" class="btn btn-primary">Invite new user</a>
				</p>



				{{>flash}}
				<table>
					<thead>
					<tr>
						<th>Pseudo</th>
						<th>Public key</th>
						<th>Created</th>
						<th>Actions</th>
					</tr>
					</thead>
					<tbody>
					{{#each users}}
					<tr>
						<td>{{this.pseudo}}</td>
						<td><code style="word-break: break-all;">{{this.publicKey}}</code></td>
						<td>{{this.createdAt}}</td>
						<td>
							<form method="post" action="/admin/users/{{this.id}}/delete" style="display:inline;">
								<button type="submit" class="btn btn-sm btn-danger" data-confirm="Delete user {{this.pseudo}}? This action cannot be undone." {{#if (eq this.id user.sub)}}disabled title="You cannot delete your own account"{{/if}}>Delete</button>
							</form>
						</td>
					</tr>
					{{else}}
					<tr><td colspan="4">No users yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
