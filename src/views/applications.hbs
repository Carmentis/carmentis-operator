<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Applications - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Applications</h2>
				<p class="text">
					An on-chain application is a blockchain space dedicated to an application,
					linked to an organization, that allows information common to all of its
					transactions to be anchored on-chain.
				</p>
				{{>flash}}
				<p><a href="/admin/applications/new" class="btn btn-primary">New application</a></p>
				<table>
					<thead>
					<tr>
						<th>Name</th>
						<th>Virtual blockchain ID</th>
						<th>Wallet</th>
						<th>Created</th>
						<th></th>
					</tr>
					</thead>
					<tbody>
					{{#each applications}}
					<tr>
						<td>{{this.name}}</td>
						<td>{{this.vbId}}</td>
						<td>{{this.wallet.name}}</td>
						<td>{{this.createdAt}}</td>
						<td class="action-buttons">
							<a href="/admin/applications/{{this.vbId}}/edit" class="btn btn-secondary">Edit</a>
							<form method="post" action="/admin/applications/{{this.vbId}}/delete" style="display:inline;">
								<button type="submit" class="btn btn-danger" data-confirm="Delete this application?">Delete</button>
							</form>
						</td>
					</tr>
					{{else}}
					<tr><td colspan="5">No applications yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
