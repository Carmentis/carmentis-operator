<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>API Keys - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>API Keys</h2>
				<p class="text">
					API keys are used to authenticate requests to the <a href="/swagger">API</a>.
				</p>
				{{>flash}}
				<p><a href="/admin/api-keys/new" class="btn btn-primary">New API key</a></p>
				<table>
					<thead>
					<tr>
						<th>Name</th>
						<th>Active</th>
						<th>Application</th>
						<th>Wallet</th>
						<th>Expires</th>
						<th>Created</th>
						<th></th>
					</tr>
					</thead>
					<tbody>
					{{#each apiKeys}}
					<tr>
						<td>{{this.name}}</td>
						<td>{{#if this.isActive}}yes{{else}}no{{/if}}</td>
						<td>{{this.application.name}}</td>
						<td>{{this.wallet.name}}</td>
						<td>{{#if this.activeUntil}}{{this.activeUntil}}{{else}}never{{/if}}</td>
						<td>{{this.createdAt}}</td>
						<td class="action-buttons">
							<a href="/admin/api-keys/{{this.id}}/edit" class="btn btn-secondary">Edit</a>
							<form method="post" action="/admin/api-keys/{{this.id}}/toggle" style="display:inline;">
								<button type="submit" class="btn btn-secondary">{{#if this.isActive}}Deactivate{{else}}Activate{{/if}}</button>
							</form>
							<form method="post" action="/admin/api-keys/{{this.id}}/delete" style="display:inline;">
								<button type="submit" class="btn btn-danger" data-confirm="Delete this API key?">Delete</button>
							</form>
						</td>
					</tr>
					{{else}}
					<tr><td colspan="7">No API keys yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
