<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{#if application}}Edit{{else}}New{{/if}} Application - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>{{#if application}}Edit application{{else}}New application{{/if}}</h2>

				<div class="flash flash-error" id="form-error" style="display:none;"></div>

				<form id="application-form">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required value="{{application.name}}">
					</div>

					{{#if application}}
					<div class="form-group">
						<label>Virtual blockchain ID</label>
						<input type="text" value="{{application.vbId}}" disabled>
					</div>
					<div class="form-group">
						<label>Wallet</label>
						<input type="text" value="{{application.wallet.name}}" disabled>
					</div>
					<p style="font-size: 12px; color: var(--color-text-secondary);">
						The virtual blockchain ID and owning wallet cannot be changed after creation.
					</p>
					{{else}}
					<div class="form-group">
						<label for="vbId">Virtual blockchain ID (hexadecimal)</label>
						<input type="text" id="vbId" name="vbId" required pattern="[0-9a-fA-F]+" placeholder="e.g. a1b2c3...">
					</div>
					<div class="form-group">
						<label for="walletId">Wallet</label>
						<select id="walletId" name="walletId" required>
							<option value="" disabled selected>Select a wallet…</option>
							{{#each wallets}}
							<option value="{{this.id}}">{{this.name}}</option>
							{{/each}}
						</select>
					</div>
					{{/if}}

					<button type="submit" class="btn btn-primary">{{#if application}}Save changes{{else}}Create application{{/if}}</button>
					<a href="/admin/applications" class="btn btn-secondary">Cancel</a>
				</form>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
	<script>
		const applicationVbId = {{#if application}}"{{application.vbId}}"{{else}}null{{/if}};

		document.getElementById('application-form').addEventListener('submit', async (e) => {
			e.preventDefault();
			const errorEl = document.getElementById('form-error');
			errorEl.style.display = 'none';

			let url, method, body;
			if (applicationVbId) {
				url = `/admin/api/v1/application/${applicationVbId}`;
				method = 'PATCH';
				body = { name: document.getElementById('name').value };
			} else {
				url = '/admin/api/v1/application';
				method = 'POST';
				body = {
					name: document.getElementById('name').value,
					vbId: document.getElementById('vbId').value,
					walletId: Number(document.getElementById('walletId').value),
				};
			}

			const res = await fetch(url, {
				method,
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});
			const data = await res.json().catch(() => ({}));
			if (!res.ok) {
				errorEl.textContent = data.message || 'Could not save this application.';
				errorEl.style.display = '';
				return;
			}
			window.location.href = '/admin/applications';
		});
	</script>
</body>
</html>
