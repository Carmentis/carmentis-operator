<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{#if application}}Edit{{else}}New{{/if}} Application - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				{{#if application}}{{> breadcrumbs section="Applications" sectionHref="/admin/applications" item=application.name itemBase="/admin/applications" itemId=application.id action="Edit"}}{{else}}{{> breadcrumbs section="Applications" sectionHref="/admin/applications" action="New"}}{{/if}}
				<h2>{{#if application}}Edit application{{else}}New application{{/if}}</h2>

				{{>flash}}

				<form method="post" action="{{#if application}}/admin/applications/{{application.id}}/update{{else}}/admin/applications{{/if}}">
					{{#if application}}
					<div class="form-group">
						<label>Wallet</label>
						<input type="text" value="{{application.wallet.name}}" disabled>
					</div>
					<div class="form-group">
						<label>Organization</label>
						<input type="text" value="{{application.organization.name}}" disabled>
					</div>
					{{#if application.vbId}}
					<div class="form-group">
						<label>Virtual blockchain ID</label>
						<input type="text" value="{{application.vbId}}" disabled>
					</div>
					{{/if}}
					{{else}}
					<div class="form-group">
						<label for="walletId">Wallet</label>
						<select id="walletId" name="walletId" required>
							<option value="" disabled selected>Select a wallet…</option>
							{{#each wallets}}
							<option value="{{this.id}}">{{this.name}}</option>
							{{/each}}
						</select>
					</div>
					<div class="form-group">
						<label for="organizationId">Organization</label>
						<select id="organizationId" name="organizationId" required>
							<option value="" disabled selected>Select an organization…</option>
							{{#each organizations}}
							<option value="{{this.id}}" data-wallet-id="{{this.wallet.id}}">{{this.name}}</option>
							{{/each}}
						</select>
					</div>
					{{/if}}
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required value="{{application.name}}">
					</div>
					<div class="form-group">
						<label for="description">Description</label>
						<textarea id="description" name="description" rows="3">{{application.description}}</textarea>
					</div>
					<div class="form-group">
						<label for="homepageUrl">Homepage URL</label>
						<input type="text" id="homepageUrl" name="homepageUrl" placeholder="https://" value="{{application.homepageUrl}}">
					</div>
					<div class="form-group">
						<label for="logoUrl">Logo URL</label>
						<input type="text" id="logoUrl" name="logoUrl" placeholder="https://" value="{{application.logoUrl}}">
					</div>
					<p style="font-size: 12px; color: var(--color-text-secondary);">
						Saving only changes the local registry. Publish the application from the list to push these values on-chain.
						The wallet and the organization cannot be changed after creation.
					</p>

					<button type="submit" class="btn btn-primary">{{#if application}}Save changes{{else}}Create application{{/if}}</button>
					<a href="/admin/applications" class="btn btn-secondary">Cancel</a>
				</form>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
	{{#unless application}}
	<script>
		// Only the organizations of the selected wallet can own the new application.
		const walletSelect = document.getElementById('walletId');
		const organizationSelect = document.getElementById('organizationId');
		function filterOrganizations() {
			organizationSelect.value = '';
			for (const option of organizationSelect.options) {
				if (option.dataset.walletId) option.hidden = option.disabled = option.dataset.walletId !== walletSelect.value;
			}
		}
		walletSelect.addEventListener('change', filterOrganizations);
		filterOrganizations();
	</script>
	{{/unless}}
</body>
</html>
