<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Wallets - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Wallets</h2>
				{{>flash}}
				<div class="flash flash-error" id="wallets-error" style="display:none;"></div>
				<p><a href="/admin/wallets/new" class="btn btn-primary">New wallet</a></p>
				<table>
					<thead>
					<tr>
						<th>Name</th>
						<th>RPC endpoint</th>
						<th>Indexer endpoint</th>
						<th>Created</th>
						<th></th>
					</tr>
					</thead>
					<tbody>
					{{#each wallets}}
					<tr>
						<td>{{this.name}}</td>
						<td>{{this.rpcEndpoint}}</td>
						<td>{{this.indexerEndpoint}}</td>
						<td>{{this.createdAt}}</td>
						<td class="action-buttons">
							<a href="/admin/wallets/{{this.id}}/edit" class="btn btn-secondary">Edit</a>
							<button class="btn btn-danger" data-confirm-message="Delete this wallet?" data-remove-id="{{this.id}}">Delete</button>
						</td>
					</tr>
					{{else}}
					<tr><td colspan="5">No wallets yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
	<script>
		document.querySelectorAll('[data-remove-id]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!window.confirm(btn.getAttribute('data-confirm-message'))) return;
				const res = await fetch(`/admin/api/v1/wallet/${btn.getAttribute('data-remove-id')}`, { method: 'DELETE' });
				if (res.ok) {
					window.location.reload();
					return;
				}
				const data = await res.json().catch(() => ({}));
				const errorEl = document.getElementById('wallets-error');
				errorEl.textContent = data.message || 'Could not delete this wallet.';
				errorEl.style.display = '';
			});
		});
	</script>
</body>
</html>
