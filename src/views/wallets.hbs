<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Wallets - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Wallets</h2>
				<p class="text">
					A wallet managed by this operator can be used to publish
					on-chain using the <a href="/swagger">API</a>.
				</p>

				{{>flash}}
				<p><a href="/admin/wallets/new" class="btn btn-primary">New wallet</a></p>
				<table>
					<thead>
					<tr>
						<th>ID</th>
						<th>Name</th>
						<th>RPC endpoint</th>
						<th>Indexer endpoint</th>
						<th>Created</th>
						<th></th>
					</tr>
					</thead>
					<tbody>
					{{#each wallets}}
					<tr>
						<td>{{this.id}}</td>
						<td><a href="/admin/wallets/{{this.id}}">{{this.name}}</a></td>
						<td>{{this.rpcEndpoint}}</td>
						<td>{{this.indexerEndpoint}}</td>
						<td>{{this.createdAt}}</td>
						<td class="action-buttons">
							<a href="/admin/wallets/{{this.id}}" class="btn btn-secondary">Details</a>
							<a href="/admin/wallets/{{this.id}}/edit" class="btn btn-secondary">Edit</a>
							<form method="post" action="/admin/wallets/{{this.id}}/delete" style="display:inline;">
								<button type="submit" class="btn btn-danger" data-confirm="Delete this wallet?">Delete</button>
							</form>
						</td>
					</tr>
					{{else}}
					<tr><td colspan="6">No wallets yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
