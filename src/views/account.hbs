<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Account - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>My account</h2>
				{{>flash}}

				<div class="form-group">
					<label>Wallet public key</label>
					<code style="word-break: break-all; display: block;">{{user.publicKey}}</code>
				</div>

				<form method="post" action="/admin/account/pseudo">
					<div class="form-group">
						<label for="pseudo">Pseudo</label>
						<input type="text" id="pseudo" name="pseudo" value="{{user.pseudo}}" required minlength="2" maxlength="32">
					</div>
					<div class="note note-warning" style="margin-bottom: 20px;">
						<div class="note-icon">!</div>
						<div class="note-content">
							<strong>Note</strong>
							<p>
								This update will only take effect after you log out and log back in.
							</p>
						</div>
					</div>
					<button type="submit" class="btn btn-primary">Save</button>
				</form>

				<div class="danger-zone">
					<h3>Delete Account</h3>
					<p>Permanently delete this account. This action cannot be undone.</p>
					<form method="post" action="/admin/account/delete">
						<div class="form-group">
							<label for="confirmation">Type DELETE to confirm</label>
							<input type="text" id="confirmation" name="confirmation" required pattern="DELETE" autocomplete="off">
						</div>
						<button type="submit" class="btn btn-danger" data-confirm="Are you sure you want to delete your account? This action cannot be undone.">Delete My Account</button>
					</form>
				</div>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
