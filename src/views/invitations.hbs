<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Invitations - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body>
	<div class="layout">
		{{>sidebar}}
		<main class="main-content">
			{{>topbar}}
			<div class="content-area">
				<h2>Invitations</h2>
				{{>flash}}
				<p class="text">
					Create an invitation link to invite a user to register to this operator.
				</p>

				{{#if newInvitationLink}}
				<div class="flash flash-success" style="display:flex; flex-direction: column; align-items: flex-start; gap: 0.5rem;">
					<strong>Invitation link created (shown once, copy it now):</strong>
					<code style="word-break: break-all;">{{newInvitationLink}}</code>
					<button type="button" class="btn btn-secondary" data-copy-text="{{newInvitationLink}}">Copy</button>
				</div>
				{{/if}}

				<form method="post" action="/admin/invitations" style="margin-bottom: 1.5rem;">
					<button type="submit" class="btn btn-primary">Create invitation link</button>
				</form>

				<table>
					<thead>
					<tr>
						<th>Created</th>
						<th>Expires</th>
						<th>Status</th>
						<th>Used by</th>
					</tr>
					</thead>
					<tbody>
					{{#each invitations}}
					<tr>
						<td>{{this.createdAt}}</td>
						<td>{{this.expiresAt}}</td>
						<td>{{this.status}}</td>
						<td>{{#if this.usedByPseudo}}{{this.usedByPseudo}}{{else}}-{{/if}}</td>
					</tr>
					{{else}}
					<tr><td colspan="4">No invitations yet.</td></tr>
					{{/each}}
					</tbody>
				</table>
			</div>
		</main>
	</div>
	<script src="/admin/static/admin.js"></script>
</body>
</html>
