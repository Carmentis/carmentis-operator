<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Admin Login - Carmentis Operator</title>
	<link rel="stylesheet" href="/admin/static/admin.css">
</head>
<body class="login-page">
	<div class="login-container">
		<div class="login-card">
			<img src="/admin/static/assets/carmentis.svg" alt="Carmentis" class="login-logo">
			<h1>Operator Admin</h1>
			{{#if error}}
			<div class="flash flash-error" id="flash">{{error}}</div>
			{{/if}}
			<div class="flash flash-error" id="desk-auth-error" style="display:none;"></div>
			<button type="button" id="login-btn" class="btn btn-primary btn-block" data-next="{{next}}">Se connecter avec Carmentis Desk</button>
			<p style="margin-top: 1rem; font-size: 12px; color: var(--color-text-secondary);">
				Vous devez avoir été invité par un administrateur pour créer un compte.
			</p>
		</div>
	</div>
	<script src="https://unpkg.com/@cmts-dev/carmentis-desk-connect-js@1.1.0/dist/index.umd.cjs"></script>
	<script src="/admin/static/carmentis-desk-auth.js"></script>
	<script src="/admin/static/admin.js"></script>
	<script>
		const loginBtn = document.getElementById('login-btn');
		const next = loginBtn.getAttribute('data-next');
		loginBtn.addEventListener('click', async () => {
			const errorEl = document.getElementById('desk-auth-error');
			errorEl.style.display = 'none';
			try {
				await authenticateWithDesk(
					'/admin/api/v1/auth/challenge',
					'/admin/api/v1/auth/login',
					'{{relayUrl}}',
				);
				window.location.href = next && next.startsWith('/admin') ? next : '/admin';
			} catch (err) {
				errorEl.textContent = err.message || 'Carmentis Desk sign-in failed.';
				errorEl.style.display = '';
			}
		});
	</script>
</body>
</html>
